{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/markfetch.txt",
        "type": "auto",
        "position": "top",
        "padding": { "left": 2 },
        "color": { "1": "white" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "white", "output": "white", "title": "white" },
        "constants": ["\u001b[37m", "\u001b[37m"]
    },
    "modules": [
        {
            "type": "custom",
            "key": "  ╭─Mark-Space─╮"
        },
        {
            "type": "command",
            "key": "  │ {$2}{$1}  user    │",
            "text": "echo $USER"
        },
         {
            "type": "kernel",
            "key": "  │ {$2}{$1}  kernel  │"
        },
        {
            "type": "os",
            "key": "  │ {$2}{$1}  os      │"
        },
         {
            "type": "wm",
            "key": "  │ {$2}{$1}  wm      │"
        },
        {
            "type": "cpu",
            "key": "  │ {$2}󰻠{$1}  cpu     │"
        },
        {
            "type": "gpu",
            "key": "  │ {$2}󰢮{$1}  gpu     │"
        },
        {
            "type": "command",
            "key": "  │ {$2}{$1}  nvme    │",
            "text": "df -h /dev/nvme0n1p2 | awk 'NR==2 {print \"NVMe \" $3 \" used / \" $2 \" total\"}'"
        },
        {
            "type": "command",
            "key": "  │ {$2}{$1}  memory  │",
            "text": "free -h | awk '/^Mem:/ {print $3 \" used / \" $2 \" total\"}'"
        },
        {
            "type": "packages",
            "key": "  │   pkgs    │"
        },
        {
            "type": "custom",
            "key": "  ╰────────────╯"
        },
        {
            "type": "colors",
            "key": "  ",
            "symbol": "circle"
        }
    ]
}