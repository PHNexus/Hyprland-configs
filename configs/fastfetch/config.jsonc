{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo/pochita.icon",
    "position": "left",
    "width": 35,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "key": " ╭─Markosv─╮",
      "keyColor": "white"
    },
    {
      "type": "command",
      "key": " │   usr  │",
      "keyColor": "white",
      "text": "echo $USER"
    },
    {
      "type": "kernel",
      "key": " │   ker  │",
      "keyColor": "white",
      "format": "{2}"
    },
    {
      "type": "os",
      "key": " │   os   │",
      "keyColor": "white",
      "format": "{3}"
    },
    {
      "type": "wm",
      "key": " │   wm   │",
      "keyColor": "white",
      "format": "{2}"
    },
    {
      "type": "cpu",
      "key": " │  󰻠 cpu  │",
      "keyColor": "white",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": " │  󰢮 gpu  │",
      "keyColor": "white",
      "format": "{2}"
    },
    {
      "type": "command",
      "key": " │   nvm  │",
      "keyColor": "white",
      "text": "df -h /dev/nvme0n1p2 | awk 'NR==2 {print $3 \"/\" $2}'"
    },
    {
      "type": "command",
      "key": " │   ssd  │",
      "keyColor": "white",
      "text": "df -h /dev/sda1 | awk 'NR==2 {print $3 \"/\" $2}'"
    },
    {
      "type": "command",
      "key": " │   ram  │",
      "keyColor": "white",
      "text": "free -h | awk '/^Mem:/ {print $3 \"/\" $2}'"
    },
    {
      "type": "packages",
      "key": " │   pkg  │",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "key": " ╰─────────╯",
      "keyColor": "white"
    },
    {
      "type": "colors",
      "key": " ",
      "symbol": "circle"
    }
  ]
}