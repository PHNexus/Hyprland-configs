{
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "일",
            "2": "이",
            "3": "삼",
            "4": "사",
            "5": "오",
            "default": "육"
        },
        "sort-by-number": true,
        "on-click": "activate",
        "hide-empty": false,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 6]
        }
    }
}