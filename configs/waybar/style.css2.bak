/* ============================================================================== */
/* GLOBAL STYLES                                                                  */
/* ============================================================================== */
* {
    font-weight: bold;
    font-size: 13px; /* Tamanho ligeiramente maior que o anterior */
    transition: all 0.5s cubic-bezier(0, 0.5, 0.35, 1);
}
/* "headphone": "󰋋",
"format-icons": {
            "default": ["", "", ""]
        },*/
window#waybar {
    background-color: rgb(0, 0, 0);
    border-radius: 0;
}

.modules-left,
.modules-center,
.modules-right {
    padding: 5px 9px; 
    margin: -12px 5px -5px 0; 
}

/* ============================================================================== */
/* SOLID BLACK BLOCKS WITH GLOWING ACCENT TEXT                                    */
/* ============================================================================== */
#workspaces,
#clock,
#custom-logo,
#custom-recorder,
#custom-notification,
#monitor,
#settings,
#media {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 9px; 
    padding: 2px 10px; 
    margin: -2px 5px -2px 10px; 
    color: @accent_color;
    text-shadow: 0px 0px 5px @accent_color; 
    box-shadow: 0 0 0px #000000;
}

#custom-logo {
    padding: 2px 17px;
}

/* ============================================================================== */
/* WORKSPACES                                                                     */
/* ============================================================================== */
#hworkspaces {
    margin: 0;
    padding: 0;
    background-color: transparent;
}

#workspaces {
    padding: 10px;
}

#workspaces button {
    background-color: rgba(2, 2, 2, 0.842);   /* compatibilidade */
    border-radius: 7px; 
    padding: 0 7px;
    margin: 4px 2px;
    min-width: 14px; 
    min-height: 0;
    opacity: 0.6;
}

#workspaces button.active {
    background-color: rgba(255, 252, 252, 0.116); 
    min-width: 35px; /* Tamanho intermediário */
    opacity: 1;
}

#workspaces button.empty {
    background-color: rgba(255, 255, 255, 0.247);
    opacity: 0.2; 
    min-width: 14px;
}

#workspaces button.empty.active {
    background-color: rgba(255, 252, 252, 0.116);
    opacity: 0.6;
    min-width: 35px;
}

#workspaces button.overview {
    background-color: rgba(20, 14, 14, 0.199);
    min-width: 35px;
}

/* ============================================================================== */
/* MODULES INSIDE GROUPS                                                          */
/* ============================================================================== */
#custom-monitor,
#custom-settings,
#cpu,
#memory,
#temperature,
#battery,
#power-profiles-daemon,
#tray,
#pulseaudio,
#backlight {
    background-color: transparent;
    /* Text is accent color */
    color: @accent_color;
    margin: -1px;
    padding: 0 8px; 
    min-width: 18px; 
    /* Apply glow to all group modules */
    text-shadow: 0px 0px 5px @accent_color;
}


/* ============================================================================== */
/* SLIDERS                                                                        */
/* ============================================================================== */
#backlight-slider slider,
#pulseaudio-slider slider {
    opacity: 0;
    background-image: none;
    border: none;
    box-shadow: none;
    background: none;
}

#backlight-slider trough,
#pulseaudio-slider trough {
    min-width: 48px; 
    min-height: 7px; 
    border-radius: 3px;
    /* Dimmed trough to contrast with the highlight */
    background: rgba(255, 255, 255, 0.2);
    margin: 0 3px;
}

#backlight-slider highlight,
#pulseaudio-slider highlight {
    min-width: 7px;
    border-radius: 3px;
    background: @accent_color;
    /* Make slider highlight glow too */
    box-shadow: 0 0 7px @accent_color;
}

/* ============================================================================== */
/* HOVER EFFECTS (EXPANDING)                                                      */
/* ============================================================================== */
#clock:hover,
#custom-logo:hover,
#custom-recorder:hover,
#custom-notification:hover {
    min-width: 70px; 
    padding: 2px 17px;
}

#workspaces button:hover {
    min-width: 30px; 
}

/* Expand modules inside groups on hover */
#power-profiles-daemon:hover,
#cpu:hover,
#memory:hover,
#temperature:hover,
#battery:hover,
#pulseaudio:hover,
#backlight:hover {
    border-radius: 5px;
    min-width: 52px; 
    padding: 0 13px;
}

#custom-monitor:hover,
#custom-settings:hover {
    border-radius: 7px;
    min-width: 35px;
    padding: 0 13px;
}

/* ============================================================================== */
/* TOOLTIPS                                                                       */
/* ============================================================================== */
tooltip {
    /* Dark tooltip background */
    background: rgba(0, 0, 0, 0.9);
    border-radius: 7px;
    padding: 9px;
}

tooltip label {
    color: @accent_color;
    text-shadow: 0px 0px 4px @accent_color;
}

/* ============================================================================== */
/* ANIMATIONS                                                                     */
/* ============================================================================== */
@keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
}