{
    "include": [
        "$HOME/.config/waybar/module/workspace_module",
        "$HOME/.config/waybar/module/notification_module",
        "$HOME/.config/waybar/module/monitor_module"
    ],
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "margin-bottom": -5,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "tooltip": true,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "custom/recorder"
    ],
    "modules-center": [
        "clock",
        "group/media"
       
    ],
    "modules-right": [
        "group/monitor",
        "group/settings",
        "custom/notification",
        "custom/power"
    ],

    "clock": {
        "format": " {:%H:%M} ",
        "format-alt": " {:%A, %d %B %Y} ",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-right": "mode",
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down"
        }
    },

    "group/settings": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 1000,
            "transition-left-to-right": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/settings",
            "battery",
            "power-profiles-daemon",
            "tray"
        ]
    },

    "group/monitor": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 1000,
            "transition-left-to-right": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/monitor",
            "cpu",
            "memory",
            "temperature"
        ]
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio/slider",
            "backlight",
            "backlight/slider"
        ]
    },
    
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "on-click": "$HOME/.local/bin/nightlight_toggle.sh",
        "tooltip-format": "Brightness: {percent}%"
    },

    "backlight/slider": {
        "min": 10,
        "max": 100,
        "orientation": "horizontal"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "plugged": [""]
        },
        "tooltip-format": "Battery: {capacity}%\nPower: {power}W\n{timeTo}",
        "tooltip": true
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 ",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "Volume: {volume}%"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "show-passive-items": true
    },
    "custom/settings": {
        "format": " ",
        "tooltip-format": "Click to show settings",
        "tooltip": true
    },

    "custom/monitor": {
        "format": " ",
        "tooltip-format": "Click to show monitor stats",
        "tooltip": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout -b 1 -c 20 -r 20 -L 1700 -R 1700 -T 325 -B 325"
    },

   "custom/logo": { 
    "format": "󱎸",
    "tooltip-format": "Have a nice day!", 
    "tooltip": true, 
    "on-click": "wofi"
 }
}
