/* ============================================================================== */
/* GLOBAL STYLES                                                                  */
/* ============================================================================== */
* {
    font-weight: bold;
    transition: all 0.5s cubic-bezier(0, 0.5, 0.35, 1);
}
/* "headphone": "󰋋",
"format-icons": {
            "default": ["", "", ""]
        },*/
window#waybar {
    background-color: rgb(0, 0, 0);
    border-radius: 0;
}

.modules-left,
.modules-center,
.modules-right {
    padding: 6px 10px;
    margin: -20px 6px -6 0 ;
}

/* ============================================================================== */
/* SOLID BLACK BLOCKS WITH GLOWING ACCENT TEXT                                    */
/* ============================================================================== */
#workspaces,
#clock,
#custom-logo,
#custom-recorder,
#custom-notification,
#monitor,
#settings,
#media {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 10px;
    padding: 2px 12px;
    margin: -2px 6px -2px 12px;
    color: @accent_color;
    text-shadow: 0px 0px 6px @accent_color; 
    box-shadow: 0 0 0px #000000;
}

#custom-logo {
    padding: 2px 20px;
}

/* ============================================================================== */
/* WORKSPACES                                                                     */
/* ============================================================================== */
#hworkspaces {
    margin: 0;
    padding: 0;
    background-color: transparent;
}

#workspaces {
    padding: 6px ;
}

#workspaces button {
  background-color: rgba(2, 2, 2, 0.842);   /* compatibilidade */
    border-radius: 8px; 
    padding: 0 8px;
    margin: 5px 2px;
    min-width: 15px;
    min-height: 0;
    opacity: 0.6;
}

#workspaces button.active {
    background-color: rgba(255, 255, 255, 0.116); 
    min-width: 40px;
    opacity: 1;
}

#workspaces button.empty {
    background-color: rgba(255, 255, 255, 0.1);
    opacity: 0.2; 
    min-width: 15px;
}

#workspaces button.empty.active {
    background-color: rgba(53, 49, 49, 0.342);
    opacity: 0.6;
    min-width: 40px;
}

#workspaces button.overview {
    background-color: rgba(20, 14, 14, 0.199);
    min-width: 40px;
}

/* ============================================================================== */
/* MODULES INSIDE GROUPS                                                          */
/* ============================================================================== */
#custom-monitor,
#custom-settings,
#cpu,
#memory,
#temperature,
#battery,
#power-profiles-daemon,
#tray,
#pulseaudio,
#backlight {
    background-color: transparent;
    /* Text is accent color */
    color: @accent_color;
    margin: -2;
    padding: 0 10px;
    min-width: 20px;
    /* Apply glow to all group modules */
    text-shadow: 0px 0px 6px @accent_color;
}


/* ============================================================================== */
/* SLIDERS                                                                        */
/* ============================================================================== */
#backlight-slider slider,
#pulseaudio-slider slider {
    opacity: 0;
    background-image: none;
    border: none;
    box-shadow: none;
    background: none;
}

#backlight-slider trough,
#pulseaudio-slider trough {
    min-width: 55px;
    min-height: 8px;
    border-radius: 4px;
    /* Dimmed trough to contrast with the highlight */
    background: rgba(255, 255, 255, 0.2);
    margin: 0 4px;
}

#backlight-slider highlight,
#pulseaudio-slider highlight {
    min-width: 8px;
    border-radius: 4px;
    background: @accent_color;
    /* Make slider highlight glow too */
    box-shadow: 0 0 8px @accent_color;
}

/* ============================================================================== */
/* HOVER EFFECTS (EXPANDING)                                                      */
/* ============================================================================== */
#clock:hover,
#custom-logo:hover,
#custom-recorder:hover,
#custom-notification:hover {
    min-width: 80px;
    padding: 2px 20px;
}

#workspaces button:hover {
    min-width: 35px;
}

/* Expand modules inside groups on hover */
#power-profiles-daemon:hover,
#cpu:hover,
#memory:hover,
#temperature:hover,
#battery:hover,
#pulseaudio:hover,
#backlight:hover {
    border-radius: 6px;
    min-width: 60px;
    padding: 0 16px;
}

#custom-monitor:hover,
#custom-settings:hover {
    border-radius: 8px;
    min-width: 40px;
    padding: 0 16px;
}

/* ============================================================================== */
/* TOOLTIPS                                                                       */
/* ============================================================================== */
tooltip {
    /* Dark tooltip background */
    background: rgba(0, 0, 0, 0.9);
    border-radius: 8px;
    padding: 10px;
}

tooltip label {
    color: @accent_color;
    text-shadow: 0px 0px 4px @accent_color;
}

/* ============================================================================== */
/* ANIMATIONS                                                                     */
/* ============================================================================== */
@keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
}